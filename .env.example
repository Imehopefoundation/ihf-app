# Copy to .env.local and fill in. NEVER commit real values — .env* is gitignored.
# Only NEXT_PUBLIC_* values reach the browser bundle; everything else is server-only.

# --- Supabase (added in Phase 1; use a DEVELOPMENT project only) ---
# Public, safe to expose:
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER-ONLY. Must never be NEXT_PUBLIC_, never sent to the client, never logged:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Field-level encryption key (server-only; held OUTSIDE the database) ---
# 32 bytes, base64 or hex. Generate: openssl rand -base64 32
# Encrypts sensitive child/guardian data before it is stored. Rotating it needs
# a re-encryption migration (tokens are versioned). NEVER commit a real value.
FIELD_ENCRYPTION_KEY=your-32-byte-base64-or-hex-key

# --- Added in later phases (left here as a reference, keep commented until used) ---
# RESEND_API_KEY=your-resend-key
# PAYSTACK_SECRET_KEY=your-paystack-secret
# PAYSTACK_WEBHOOK_SECRET=your-paystack-webhook-secret
# TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
