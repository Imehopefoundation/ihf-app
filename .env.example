# Copy to .env.local and fill in. NEVER commit real values — .env* is gitignored.
# This app runs Supabase ENTIRELY server-side (no browser Supabase client), so
# none of these are NEXT_PUBLIC_ — nothing here reaches the browser bundle.

# --- Supabase (use a DEVELOPMENT project only) ---
NEXT_SUPABASE_URL=https://your-project.supabase.co
NEXT_SUPABASE_ANON_KEY=your-supabase-anon-key
# SERVER-ONLY. Never sent to the client, never logged:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Site (used for login links in emails, etc.) ---
NEXT_SITE_URL=http://localhost:3000

# --- Field-level encryption key (server-only; held OUTSIDE the database) ---
# 32 bytes, base64 or hex. Generate: openssl rand -base64 32
# Encrypts sensitive child/guardian data before it is stored. Rotating it needs
# a re-encryption migration (tokens are versioned). NEVER commit a real value.
FIELD_ENCRYPTION_KEY=your-32-byte-base64-or-hex-key

# --- Email via Gmail API (OAuth2) — all OPTIONAL ---
# Leave unset and email sending is a safe no-op (dev). Set ALL FOUR to enable.
# See docs/SECURITY.md and the setup steps. Server-only; never logged.
# GMAIL_SENDER=imehopefoundation@gmail.com
# GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-oauth-client-secret
# GOOGLE_REFRESH_TOKEN=your-foundation-account-refresh-token

# --- Class-reminder cron (server-only) ---
# Shared secret the /api/cron/reminders route requires. On Vercel, set this and
# Vercel Cron sends it automatically as `Authorization: Bearer <CRON_SECRET>`.
# Generate: openssl rand -base64 32
# CRON_SECRET=your-random-cron-secret

# --- Added in later phases (keep commented until used) ---
# TURNSTILE_SECRET_KEY=your-cloudflare-turnstile-secret
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-cloudflare-turnstile-site-key
